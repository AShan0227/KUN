# KUN 环境变量示例
# 复制为 .env 并填入真实值。不要把 .env 提交到 git。

# ===== 部署模式 =====
KUN_ENV=dev                       # dev / staging / production
KUN_LOG_LEVEL=INFO
KUN_DEFAULT_TENANT_ID=u-sylvan    # dev/staging fallback；production 会强制要求显式 tenant

# ===== Postgres =====
# Host 端口和 docker-compose.dev.yml 映射一致 (避免和其他项目冲突)。
# 应用运行时用非 superuser 角色 kun_app，让 Postgres RLS 真正生效；
# alembic/outbox 等系统任务走 admin DSN，走 superuser 绕过 RLS。
KUN_PG_DSN=postgresql+asyncpg://kun_app:kun_app@localhost:55432/kun
KUN_PG_ADMIN_DSN=postgresql+asyncpg://kun:kun@localhost:55432/kun
KUN_PG_POOL_SIZE=10

# ===== Redis =====
KUN_REDIS_URL=redis://localhost:6379/0

# ===== Qdrant =====
KUN_QDRANT_URL=http://localhost:16333
KUN_QDRANT_API_KEY=

# ===== NATS =====
KUN_NATS_URL=nats://localhost:4222

# ===== MinIO / S3 =====
KUN_S3_ENDPOINT=http://localhost:19000
KUN_S3_ACCESS_KEY=minio
KUN_S3_SECRET_KEY=minio123
KUN_S3_BUCKET=kun-artifacts
KUN_S3_REGION=us-east-1

# ===== LLM Providers =====
# ADR-002: 开发期主力 Opus 4.7 + 次力 Codex 5.3 + 便宜档 Haiku/Sonnet + Fallback MiniMax
# 走 ofox proxy 做统一入口
KUN_OFOX_PROXY_URL=https://api.ofox.ai
KUN_OFOX_API_KEY=

# Anthropic (可选直连)
ANTHROPIC_API_KEY=

# OpenAI (可选直连)
OPENAI_API_KEY=

# MiniMax (ADR-002 fallback)
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=minimax-m2.7

# ===== CLI OAuth providers =====
# Claude Code CLI (top/strong/cheap): uses your Claude Pro/Max subscription.
# Codex MCP server  (coding):         uses your ChatGPT subscription.
# Default model: gpt-5.5 (codex CLI ≥ 0.125). Older CLIs may need gpt-5.3-codex-spark.
# KUN_CODEX_ONLY=1             # pin every tier (top/strong/cheap/coding/fallback) to one Codex MCP
# KUN_DISABLE_CODEX_CLI=1      # kill codex (MCP + exec), fall through to OpenAI/MiniMax
# KUN_DISABLE_CLI_OAUTH=1      # kill all CLI OAuth (claude + codex)
# KUN_CODEX_MCP_CWD=/tmp/kun-codex-cwd  # codex subprocess cwd (must be ASCII; defaults to /tmp/kun-codex-cwd)
# KUN_CODEX_MCP_SANDBOX=read-only       # codex sandbox mode (read-only | workspace-write | danger-full-access)
# KUN_CODEX_REASONING=low               # low | medium | high | xhigh
# KUN_CODEX_MCP_STREAM_LIMIT_BYTES=16777216  # max single JSON-RPC payload from codex
KUN_CODEX_MCP_MODEL=gpt-5.5

# ===== Subscription quota (5h rolling window) =====
# Hard downgrade caps: "none" = never auto-downgrade (test mode default for
# top/strong/cheap — user is on a flat subscription, not cost-sensitive).
# KUN_QUOTA_TOP=none
# KUN_QUOTA_STRONG=none
# KUN_QUOTA_CHEAP=none
# KUN_QUOTA_FALLBACK=10000     # MiniMax is metered, keep a cap
# Soft warn thresholds — log once per 30min when usage crosses this in the 5h
# window. Heads-up before the Claude Pro rate limit bites. 0 = silent.
# KUN_QUOTA_WARN_TOP=30
# KUN_QUOTA_WARN_STRONG=150
# KUN_QUOTA_WARN_CHEAP=0

# ===== OpenTelemetry =====
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317
OTEL_SERVICE_NAME=kun-api
OTEL_RESOURCE_ATTRIBUTES=service.name=kun-api,service.version=0.1.0

# ===== API =====
KUN_API_HOST=0.0.0.0
KUN_API_PORT=8000
# Comma-separated allowed origins (no wildcard). Audit F153: if the Next dev
# server falls back to another port (e.g. 3001 when 3000 is busy), add it here,
# otherwise browser requests are CORS-rejected:
#   KUN_API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
KUN_API_CORS_ORIGINS=http://localhost:3000

# ===== Budgets (ADR default, 可通过 UI 修改) =====
KUN_BUDGET_DAILY_USD=10.0
KUN_BUDGET_MONTHLY_USD=200.0

# ===== Tenant context =====
# Tenant used by background jobs (idle-batch, nats subscriber) that don't have
# an ambient request context. Production should set this per-deploy.
# KUN_TENANT_ID=u-sylvan

# ===== Background workers =====
# KUN_IDLE_BATCH_ENABLED=1                  # 0 = disable idle-batch worker entirely
# KUN_IDLE_BATCH_INTERVAL_SEC=3600          # how often to run all enabled steps
# KUN_NATS_SUBSCRIBER_ENABLED=1             # 0 = don't start the watchtower subscriber
# KUN_NATS_SUBSCRIBE_SUBJECT=kun.>          # NATS subject filter
# KUN_NATS_QUEUE_GROUP=kun-watchtower       # for horizontal scaling

# ===== A/B routing experiments =====
# KUN_AB_RATIO=0                            # 0.0-1.0 fraction of traffic to challenger
# KUN_AB_TOP_CHALLENGER_TIER=strong         # which tier's provider to use as challenger for top
# KUN_AB_FALLBACK_ON_NATIVE_TIMEOUT=1
# KUN_AB_DISABLE_EXTERNAL_COMPAT_FALLBACK=0

# ===== Capability router =====
# KUN_CAPABILITY_ROUTER_ENABLED=1           # 0 to bypass capability-card-driven model pick

# ===== Skills sandbox =====
# KUN_SKILL_EXEC_ROOT=/tmp/kun-skill-exec   # where python-exec / shell-like skills sandbox files
# KUN_SKILL_EXEC_ROOTS=/tmp/kun-skill-exec  # multiple comma-separated allowed roots
# KUN_SKILL_FILE_ROOT=/tmp/kun-skill-files  # read/write boundary for file skills

# ===== Control plane (V6) =====
# KUN_CONTROL_PLANE_NETWORK_PREFLIGHT=1     # require network egress probe before runner starts
# KUN_CONTROL_PLANE_REQUIRE_NETWORK_PREFLIGHT=0  # hard-fail if preflight unreachable
# KUN_CONTROL_PLANE_STRICT_SKILL_REGISTRY=0 # error out if a runner references unregistered skill

# ===== Mission director (LLM-driven runner) =====
# KUN_MISSION_DIRECTOR_MODE=disabled        # disabled | observer | active
# KUN_MISSION_DIRECTOR_PROVIDER=codex-mcp
# KUN_MISSION_DIRECTOR_MODEL_ID=gpt-5.5

# ===== Runtime direct codex (advanced) =====
# KUN_RUNTIME_DIRECT_CODEX_REASONING=low    # bypass router, hit codex directly
# KUN_RUNTIME_DIRECT_CODEX_SANDBOX=read-only

# ===== Misc =====
# KUN_KEEP_THINK=0                          # 1 to retain reasoning blocks in user-visible answer

# ===== Auth (KNOWN GAP — see CLAUDE.md or docs/SECURITY.md) =====
# No real auth is enforced yet. HTTP reads X-Tenant-Id header, WS reads
# tenant_id query param, neither is signed/verified. Until an auth proxy or
# Bearer scheme lands:
#   - production refuses to start with KUN_DEFAULT_TENANT_ID set
#   - KUN_WS_REQUIRE_AUTH_HEADER=1 refuses any WS connection that supplies
#     tenant_id via query (force callers to come through an auth proxy that
#     sets it via a verified cookie/header)
# KUN_WS_REQUIRE_AUTH_HEADER=0

# =============================================================================
# 以下为 audit F119 补全：代码实际读取但此前未文档化的变量。注释默认值取自
# kun/core/config.py 字段默认 与 各 os.getenv 调用默认（已逐一核对）。
# 全部以 # 注释示例给出 —— 取消注释并改值即可生效。
# =============================================================================

# ===== Auth (ADR-019) — ⚠️ 生产必开 =====
# 关闭时 API 仅凭未验证的 X-Tenant-Id 头信任租户；production 启动会 fail-closed
# 拒绝（见 kun/core/config.py _production_safety, audit F007a）。
# KUN_AUTH_ENABLED=false                     # ⚠️ 生产必须 =true
# KUN_AUTH_JWT_SECRET=                       # ⚠️ AUTH_ENABLED=true 时必填，≥32 字符
#                                            #   python -c "import secrets;print(secrets.token_urlsafe(48))"
# KUN_AUTH_TOKEN_TTL_SECONDS=3600            # 访问令牌有效期秒（≥60）

# ===== External Supervisor (ADR-023) — 本地推理引擎 (ollama/llama.cpp/vLLM) =====
# KUN_EXTERNAL_SUPERVISOR_ENABLED=false
# KUN_EXTERNAL_SUPERVISOR_MODEL_ID=qwen2.5:32b
# KUN_EXTERNAL_SUPERVISOR_BASE_URL=http://localhost:11434/v1
# KUN_EXTERNAL_SUPERVISOR_API_KEY=ollama
# KUN_EXTERNAL_SUPERVISOR_TIMEOUT_SEC=120
# KUN_EXTERNAL_SUPERVISOR_MAX_CONCURRENT=2

# ===== Budget / limits (ADR-008) =====
# KUN_BUDGET_WARN_FRACTION=0.8               # 日预算用到该比例发 warning
# KUN_TASK_MAX_DURATION_SEC=1800             # 单任务硬上限秒，超时取消
# KUN_RESULT_OFFLOAD_THRESHOLD_BYTES=51200   # 结果超此大小转存 MinIO（50 KiB）
# KUN_MISSED_TOOL_THRESHOLD=10               # 同 (tenant,skill,pattern) 漏触发 N 次后晋级学习触发器

# ===== V7 特性开关族（默认全部 OFF / opt-in；RSI 闭环核心，新部署默认关）=====
# Trifecta（过去/现在/未来三重审查）
# KUN_V7_TRIFECTA_ENABLED=false              # 主开关
# KUN_V7_TRIFECTA_PAST_ENABLED=false
# KUN_V7_TRIFECTA_PRESENT_ENABLED=false
# KUN_V7_TRIFECTA_FUTURE_ENABLED=false
# KUN_V7_TRIFECTA_ORCHESTRATOR_ENABLED=false
# KUN_V7_TRIFECTA_EVERY_N_STEPS=5
# Ensemble（多模型合议）
# KUN_V7_ENSEMBLE_ENABLED=false              # 主开关
# KUN_V7_ENSEMBLE_STRATEGY=majority
# KUN_V7_ENSEMBLE_TIERS=                     # 逗号分隔 tier 列表
# KUN_V7_ENSEMBLE_LOCAL_BASE_URL=http://localhost:11434/v1
# KUN_V7_ENSEMBLE_LOCAL_MODEL_ID=qwen2.5:32b
# Methodology 注入
# KUN_V7_METHODOLOGY_INJECT_ENABLED=false
# KUN_V7_METHODOLOGY_TOP_K=3
# KUN_V7_METHODOLOGY_DIR=
# KUN_V7_METHODOLOGY_TO_GATE_BRIDGE_ENABLED=false
# Auditor / discipline / bridges（均默认关）
# KUN_V7_AUDITOR_USE_LLM=false               # 开则花钱调 LLM
# KUN_V7_AUDITOR_REPORT_BRIDGE_ENABLED=false
# KUN_V7_DISCIPLINE_ENFORCER_ENABLED=false
# KUN_V7_CAPABILITY_LIFECYCLE_BRIDGE_ENABLED=false
# KUN_V7_MISSION_DIRECTOR_BRIDGE_ENABLED=false
# KUN_V7_MD_DAEMON_TICK_ENABLED=
# KUN_V7_CRITIQUE_EVERY_N_STEPS=5

# ===== 运行 / 调度 操作开关（默认值见注释）=====
# KUN_CAPABILITY_ROUTER_ENABLED=1
# KUN_IDLE_BATCH_ENABLED=1
# KUN_IDLE_BATCH_INTERVAL_SEC=3600
# KUN_IDEMPOTENCY_GC_ENABLED=1
# KUN_IDEMPOTENCY_GC_INTERVAL_SEC=3600
# KUN_NATS_SUBSCRIBER_ENABLED=1
# KUN_NATS_SUBSCRIBE_SUBJECT=kun.>
# KUN_NATS_QUEUE_GROUP=kun-watchtower
# KUN_CONTROL_PLANE_NETWORK_PREFLIGHT=0
# KUN_CONTROL_PLANE_REQUIRE_NETWORK_PREFLIGHT=0
# KUN_CONTROL_PLANE_STRICT_SKILL_REGISTRY=0
# KUN_V6_CONTROL_PLANE_STORE=.kun-local/v6-control-plane.json
# KUN_V6_DAEMON_STATE=.kun-local/v6-daemon-service.json

# ===== Quota（每 tier: top/strong/cheap/coding/fallback）=====
# KUN_QUOTA_TOP=            # 各 tier 日 token 配额（留空=无限）
# KUN_QUOTA_STRONG=
# KUN_QUOTA_CHEAP=
# KUN_QUOTA_FALLBACK=
# KUN_QUOTA_WARN_TOP=       # 各 tier warn 阈值
# KUN_QUOTA_WARN_STRONG=
# KUN_QUOTA_WARN_CHEAP=
# KUN_QUOTA_WARN_FALLBACK=

# ===== Skill 执行沙箱（命令策略见 kun/skills/command_policy.py）=====
# KUN_SHELL_EXEC_ALLOW=     # 设置则切 allowlist 模式（仅列出命令可跑，fail-closed）
# KUN_SHELL_EXEC_DENY=      # 额外 deny 正则（换行 或 ;; 分隔）
# KUN_SKILL_EXEC_ROOTS=     # 可执行 skill 的 cwd 根（多个）
# KUN_SKILL_FILE_ROOT=      # file-io skill 限定根
